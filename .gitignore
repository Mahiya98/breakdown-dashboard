# Pipeline build artifacts -- regenerated by deploy_and_publish.sh / run_pipeline.sh,
# not meant to be hand-edited or diffed. The one published output is
# vrm-prediction/index.html, committed explicitly by deploy_and_publish.sh.
__pycache__/
*.pyc
*.log
pipeline/dashboard.html
pipeline/dashboard_data.json
pipeline/excluded_columns_log.json

# Result CSVs ARE tracked (deploy_and_publish.sh adds them explicitly) so model
# performance history is visible in git log without rerunning the pipeline:
#   pipeline/dashboard_predictions.csv
#   pipeline/dashboard_accuracy_metrics.csv
#   pipeline/model_comparison_results.csv
#   pipeline/step10_electrical_mechanical_results.csv
#   pipeline/reason_predictions.csv
#   pipeline/reason_model_metrics.csv
